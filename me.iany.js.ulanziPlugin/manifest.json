{
  "Author": "iany",
  "Name": "iany's JS Widgets",
  "Description": "A collection of JavaScript widgets for Ulanzi Deck.",
  "Icon": "resources/icon.svg",
  "Version": "1.0.0",
  "Category": "iany's JS Widgets",
  "CategoryIcon": "resources/icon.svg",
  "CodePath": "plugin/main.js",
  "Type": "JavaScript",
  "PrivateAPI": true,
  "UUID": "me.iany.ulanzistudio.js",
  "Actions": [
    {
      "Name": "Clash Traffic",
      "Icon": "resources/clash-traffic/action-icon.svg",
      "PropertyInspectorPath": "property-inspector/clash-traffic/inspector.html",
      "state": 0,
      "States": [
        {
          "Name": "Connected",
          "Image": "resources/clash-traffic/action-icon.svg"
        },
        {
          "Name": "Disconnected",
          "Image": "resources/clash-traffic/offline.svg"
        }
      ],
      "Tooltip": "Show Clash up/down traffic chart",
      "UUID": "me.iany.ulanzistudio.js.clashTraffic",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
      "Name": "AI Usage",
      "Icon": "resources/ai-usage/action-icon.svg",
      "PropertyInspectorPath": "property-inspector/ai-usage/inspector.html",
      "state": 0,
      "States": [
        {
          "Name": "Usage",
          "Image": "resources/ai-usage/action-icon.svg"
        }
      ],
      "Tooltip": "Show AI remaining usage percentage and reset time",
      "UUID": "me.iany.ulanzistudio.js.aiUsage",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    }
  ],
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "10.11"
    }
  ],
  "Software": {
    "MinVersion": "2.1.0"
  }
}
